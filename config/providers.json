{
  "default_profile": "mock-local",
  "profiles": {
    "mock-local": {
      "provider_kind": "mock",
      "model": "mock-model",
      "temperature": 0.0,
      "reasoning_effort": "medium",
      "timeout_seconds": 30,
      "max_retries": 0,
      "max_output_tokens": 1600
    },
    "lmstudio-local": {
      "provider_kind": "lmstudio_openai_compat",
      "model": "google/gemma-4-e2b",
      "base_url": "http://127.0.0.1:1234/v1",
      "temperature": 0.0,
      "reasoning_effort": "medium",
      "timeout_seconds": 300,
      "max_retries": 1,
      "max_output_tokens": 1400
    },
    "gemini-main": {
      "provider_kind": "gemini",
      "model": "gemma-4-31b-it",
      "api_key_env": "GEMINI_API_KEY",
      "temperature": 0.1,
      "reasoning_effort": "medium",
      "timeout_seconds": 180,
      "max_retries": 2,
      "max_output_tokens": 1800
    },
    "openrouter-main": {
      "provider_kind": "openrouter",
      "model": "google/gemini-2.5-pro",
      "api_key_env": "OPENROUTER_API_KEY",
      "temperature": 0.1,
      "reasoning_effort": "medium",
      "timeout_seconds": 180,
      "max_retries": 2,
      "max_output_tokens": 1800
    }
  }
}
